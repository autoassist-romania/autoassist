{
  "crons": [
    { "path": "/api/ping-supabase", "schedule": "0 10 * * *" },
    { "path": "/api/sync-fuel", "schedule": "0 6 * * *" },
    { "path": "/api/sync-fuel?full=1", "schedule": "0 6 * * 1" }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" }
      ]
    },
    {
      "source": "/(index.html|app.html|core.js|rca-itp.js|vanzare-cv.js|asistent.js|documente.js|mentenanta.js|piese.js|ev-vocal-init.js|style.css|flota.js|push.js|support-chat.js|cautare.js|cookie-consent.js|admin-clienti.js|export-docx.js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
